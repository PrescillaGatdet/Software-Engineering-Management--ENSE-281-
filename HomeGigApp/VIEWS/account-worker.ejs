<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeGigs | Account Menu</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Fugaz+One&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="CSS/style.css">
</head>
<body class="worker-mode">

    <nav id="sidebar">
        <div class="nav-links">
            <div class="top-nav">
                <a href="/dashboard-worker">
                    <img src="IMAGES/HomeSymbol.png" class="nav-icon" alt="Home">
                </a>
                <a href="/chats-worker"><img src="IMAGES/InboxSymbol.png" class="nav-icon" alt="Chats"></a>
                <a href="/earnings">
                    <img src="IMAGES/EarningSymbol.png" class="nav-icon" alt="Earnings">
                </a>
            </div>
            
            <div class="bottom-nav">
                <a href="/account-worker" class="active">
                    <img src="IMAGES/ProfileSymbol.png" class="nav-icon" alt="Profile">
                </a>
            </div>
        </div>
    </nav>

    <main class="dashboard-content">
        <header class="dashboard-header">
            <div class="title-container">
                <img id="DashboardLogo" src="IMAGES/HomeGigsLogo.png" alt="HomeGigs Logo">
                <h1 class="purple-heading">Account Menu</h1>
            </div>
        </header>

        <section class="content-body">
    <div class="account-menu-grid">
        <a href="#" class="menu-card">
            <span class="menu-title">Option A</span>
        </a>
        <a href="#" class="menu-card">
            <span class="menu-title">Option B</span>
        </a>
        <a href="#" class="menu-card">
            <span class="menu-title">Option C</span>
        </a>
        <a href="/index" class="menu-card logout-card">
            <span class="menu-title">Log Out</span>
        </a>
    </div>
</section>
    </main>
    
    <div id="logoutModal" class="modal-overlay">
    <div class="modal-content">
        <p class="welcome-text" style="margin-left: 0; text-align: center; margin-bottom: 35px; font-size: 1.4rem;">
            Are you sure you want to logout?
        </p>
        
        <div class="modal-buttons">
            <button id="closeModal" class="homegigs-button" style="background: #EEEEEE; color: #000000;">CANCEL</button>
            <a href="/index" class="homegigs-button logout-confirm-btn">LOGOUT</a>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="JAVASCRIPT/script.js"></script>
<script src="JAVASCRIPT/popups.js"></script>
    
</body>
</html>