<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeGigs | Earnings</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Fugaz+One&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="CSS/style.css">
</head>
<body class="worker-mode">

    <nav id="sidebar">
        <div class="nav-links">
            <div class="top-nav">
                <a href="dashboard-worker.html">
                    <img src="IMAGES/HomeSymbol.png" class="nav-icon" alt="Home">
                </a>
                <a href="chats-worker.html"><img src="IMAGES/InboxSymbol.png" class="nav-icon" alt="Chats"></a>
                <a href="earnings.html" class="active">
                    <img src="IMAGES/EarningSymbol.png" class="nav-icon" alt="Earnings">
                </a>
            </div>
            
            <div class="bottom-nav">
                <a href="account-worker.html">
                    <img src="IMAGES/ProfileSymbol.png" class="nav-icon" alt="Profile">
                </a>
            </div>
        </div>
    </nav>

    <main class="dashboard-content">
        <header class="dashboard-header">
            <div class="title-container">
                <img id="DashboardLogo" src="IMAGES/HomeGigsLogo.png" alt="HomeGigs Logo">
                <h1 class="purple-heading">Earning Statements</h1>
            </div>
            <p class="welcome-text">Check out the aspects of your completed gigs and their respective earnings...</p>
        </header>

        <section class="content-body">
            <% if (gigs && gigs.length > 0) { %>
                <div class="earnings-list-container">
                    <% gigs.forEach(item => { %>
                        <div class="earning-statement-tile">
                            <div class="statement-info-content">
                                <h3 class="statement-title-text"><%= item.title %></h3>
                                <p class="statement-detail-text">
                                    <%= item.category %> | <%= item.address %>
                                </p>
                            </div>
                            <div class="statement-price-right">
                                $<%= item.budget %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="placeholder-card">
                    <p>No earning statements found for this period.</p>
                </div>
            <% } %>
        </section>
    </main>

    <script src="JAVASCRIPT/script.js"></script>
</body>
</html>