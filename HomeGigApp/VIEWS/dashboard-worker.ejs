<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeGigs | Worker Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Fugaz+One&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="CSS/style.css">
</head>
<body class="worker-mode">

    <nav id="sidebar">
        <div class="nav-links">
            <div class="top-nav">
                <a href="dashboard-worker.html" class="active">
                    <img src="IMAGES/HomeSymbol.png" class="nav-icon" alt="Home">
                </a>
                <a href="chats-worker.html"><img src="IMAGES/InboxSymbol.png" class="nav-icon" alt="Chats"></a>
                <a href="earnings.html"><img src="IMAGES/EarningSymbol.png" class="nav-icon" alt="Earnings"></a>
            </div>
            
            <div class="bottom-nav">
                <a href="account-worker.html"><img src="IMAGES/ProfileSymbol.png" class="nav-icon" alt="Profile"></a>
            </div>
        </div>
    </nav>

    <main class="dashboard-content">
        <header class="dashboard-header">
            <div class="title-container">
                <img id="DashboardLogo" src="IMAGES/HomeGigsLogo.png" alt="HomeGigs Logo">
                <h1 class="purple-heading">Worker Dashboard</h1>
            </div>
            <p class="welcome-text">Welcome! Find yourself a gig for now or schedule one for near future and earn money...</p>
        </header>

        <section class="content-body">
            <h2 class="carousel-heading">Gigs by category</h2>
            <div class="carousel-container">
                <div class="carousel-track">
                   <a href="assembling.html"><img src="IMAGES/AssemblingTile.png" alt="Assembling" class="carousel-tile"></a>
                   <a href="leaves-raking.html"><img src="IMAGES/LeavesRakingTile.png" alt="Leaves Raking" class="carousel-tile"></a>
                   <a href="moving.html"><img src="IMAGES/MovingTile.png" alt="Moving" class="carousel-tile"></a>
                   <a href="painting.html"><img src="IMAGES/PaintingTile.png" alt="Painting" class="carousel-tile"></a>
                   <a href="plumbing.html"><img src="IMAGES/PlumbingTile.png" alt="Plumbing" class="carousel-tile"></a>
                   <a href="snow-blowing.html"><img src="IMAGES/SnowBlowingTile.png" alt="Snow Blowing" class="carousel-tile"></a>
                   <a href="windows-cleaning.html"><img src="IMAGES/WindowsCleaningTile.png" alt="Windows Cleaning" class="carousel-tile"></a>
                </div>
            </div>

            <h2 class="carousel-heading">Gigs by time</h2>
            <div class="gigs-time-container">
                <div class="gig-column">
                    <div class="column-header">On The Spot</div>
                    <div class="column-content">
                        <% if (typeof gigs !== 'undefined' && gigs.length > 0) { %>
                            <% gigs.forEach(gig => { %>
                                <% if (!gig.date_needed || gig.date_needed === "") { %>
                                    <div class="gig-detail-tile"
                                    data-id="<%= gig._id %>"
                                         data-title="<%= gig.title %>"
                                         data-category="<%= gig.category %>"
                                         data-description="<%= gig.description %>"
                                         data-budget="<%= gig.budget %>"
                                         data-date="On The Spot"
                                         data-address="<%= gig.address %>"
                                         data-images="<%= gig.images ? gig.images.join(',') : '' %>">
                                        <h3><%= gig.title.toUpperCase() %></h3>
                                        <p><strong>Category:</strong> <%= gig.category %></p>
                                        <p><strong>Budget:</strong> $<%= gig.budget %></p>
                                        <p><strong>Address:</strong> <%= gig.address %></p>
                                    </div>
                                <% } %>
                            <% }); %>
                        <% } %>
                    </div>
                </div>

                <div class="gig-column">
                    <div class="column-header">Schedule Ahead</div>
                    <div class="column-content">
                        <% if (typeof gigs !== 'undefined' && gigs.length > 0) { %>
                            <% gigs.forEach(gig => { %>
                                <% if (gig.date_needed && gig.date_needed !== "") { 
                                    const d = new Date(gig.date_needed);
                                    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                                    let formattedDate = months[d.getUTCMonth()] + " " + d.getUTCDate();
                                %>
                                    <div class="gig-detail-tile"
                                    data-id="<%= gig._id %>"
                                         data-title="<%= gig.title %>"
                                         data-category="<%= gig.category %>"
                                         data-description="<%= gig.description %>"
                                         data-budget="<%= gig.budget %>"
                                         data-date="<%= formattedDate %>"
                                         data-address="<%= gig.address %>"
                                         data-images="<%= gig.images ? gig.images.join(',') : '' %>">
                                        <h3><%= gig.title.toUpperCase() %></h3>
                                        <p><strong>Category:</strong> <%= gig.category %></p>
                                        <p><strong>Budget:</strong> $<%= gig.budget %></p>
                                        <p><strong>Date:</strong> <%= formattedDate %></p>
                                        <p><strong>Address:</strong> <%= gig.address %></p>
                                    </div>
                                <% } %>
                            <% }); %>
                        <% } %>
                    </div>
                </div>
            </div>

            <% if (typeof gigs === 'undefined' || gigs.length === 0) { %>
                <div class="placeholder-card">
                    <p>Currently, no gigs are available in your area. Please try again later.</p>
                </div>
            <% } %>
            <div style="height: 100px;"></div>
        </section>
    </main>

    <div id="gigDetailsModalWorker" class="modal-overlay">
        <div class="modal-content gig-view-card">
            <h2 id="work-display-title" class="purple-heading detail-main-title"></h2>
            
            <div class="detail-triple-row">
                <div class="detail-slot-row">
                    <label>Gig Category:</label>
                    <p id="work-display-category" class="static-slot"></p>
                </div>
                <div class="detail-slot-row">
                    <label>Gig Budget:</label>
                    <p id="work-display-budget" class="static-slot"></p>
                </div>
                <div class="detail-slot-row">
                    <label>Gig Date:</label>
                    <p id="work-display-date" class="static-slot"></p>
                </div>
            </div>

            <div class="detail-slot-row">
                <label>Gig Description:</label>
                <p id="work-display-description" class="static-slot description-slot"></p>
            </div>

            <div class="detail-slot-row">
                <label>Gig Address:</label>
                <p id="work-display-address" class="static-slot"></p>
            </div>

            <div class="detail-slot-row">
                <label>Gig Images:</label>
                <div id="work-display-images" class="image-display-area"></div>
            </div>

            <div class="modal-buttons">
                <button class="homegigs-button accept-btn">ACCEPT GIG</button>
                <button class="homegigs-button bargain-btn">BARGAIN GIG</button>
            </div>

            <div class="back-button-container">
                <a href="javascript:void(0)" class="back-arrow-link" onclick="$('#gigDetailsModalWorker').fadeOut(300)">
                    <svg width="60" height="24" viewBox="0 0 60 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 12H59M1 12L12 1M1 12L12 23" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="JAVASCRIPT/script.js"></script>
    <script src="JAVASCRIPT/popups.js"></script>
</body>
</html>