<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeGigs | Customer Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Fugaz+One&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="CSS/style.css">
</head>
<body class="customer-mode">

    <nav id="sidebar">
        <div class="nav-links">
            <div class="top-nav">
                <a href="dashboard-customer.html" class="active">
                    <img src="IMAGES/HomeSymbol.png" class="nav-icon" alt="Home">
                </a>
                <a href="chats-customer.html"><img src="IMAGES/InboxSymbol.png" class="nav-icon" alt="Chats"></a>
                <a href="post-gig.html"><img src="IMAGES/AddPostSymbol.png" class="nav-icon" alt="Add Post"></a>
            </div>
            
            <div class="bottom-nav">
                <a href="account-customer.html"><img src="IMAGES/ProfileSymbol.png" class="nav-icon" alt="Profile"></a>
            </div>
        </div>
    </nav>

    <main class="dashboard-content">
        <header class="dashboard-header">
            <div class="title-container">
                <img id="DashboardLogo" src="IMAGES/HomeGigsLogo.png" alt="HomeGigs Logo">
                <h1 class="purple-heading">Customer Dashboard</h1>
            </div>
            <p class="welcome-text">Welcome [First Name]! Administer your gig requests and check out your gig reports here...</p>
        </header>

        <section class="content-body">
            <h2 class="carousel-heading">Posted Gigs</h2>

            <div class="gigs-time-container">
                <div class="gig-column">
                    <div class="column-header">Gig Details</div>
                    <div class="column-content">
                        <% if (typeof gigs !== 'undefined' && gigs.length > 0) { %>
                            <% gigs.forEach(gig => { %>
                                <div class="gig-detail-tile" 
                                     data-id="<%= gig._id %>"
                                     data-title="<%= gig.title %>"
                                     data-category="<%= gig.category %>"
                                     data-description="<%= gig.description %>"
                                     data-budget="<%= gig.budget %>"
                                     data-date="<%= gig.date_needed %>"
                                     data-address="<%= gig.address %>"
                                     data-images="<%= gig.images ? gig.images.join(',') : '' %>">
                                    <h3><%= gig.title.toUpperCase() %></h3>
                                    <p><strong>Category:</strong> <%= gig.category %></p>
                                    <p><strong>Budget:</strong> $<%= gig.budget %></p>
                                    <p><strong>Address:</strong> <%= gig.address %></p>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>
                </div>

                <div class="gig-column">
                    <div class="column-header">Gig Status</div>
                    <div class="column-content">
                        <% if (typeof gigs !== 'undefined' && gigs.length > 0) { %>
                            <% gigs.forEach(gig => { 
                                // Logic for color-coded status tiles
                                let currentStatus = (gig.status || "OPEN").toUpperCase();
                                let statusClass = "status-open"; 

                                if(currentStatus === "BARGAIN") {
                                    statusClass = "status-bargain";
                                } else if(currentStatus === "CONFIRM") {
                                    statusClass = "status-confirm";
                                } else if(currentStatus === "COMPLETE" || currentStatus === "COMPLETED") {
                                    statusClass = "status-completed";
                                }

                                let displayDate = "⏳ On The Spot";
                                if (gig.date_needed) {
                                    const d = new Date(gig.date_needed);
                                    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                                    displayDate = "📅 Scheduled - " + months[d.getUTCMonth()] + " " + d.getUTCDate();
                                }
                            %>
                                <div class="gig-status-tile <%= statusClass %>">
                                    <p><strong>Type:</strong> <%= displayDate %></p>
                                    <p><strong>Status:</strong> <span class="status-label"><%= currentStatus %></span></p>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>
                </div>
            </div>

            <% if (typeof gigs === 'undefined' || gigs.length === 0) { %>
                <div class="placeholder-card">
                    <p>Currently, you have no gigs posted. Click on the add gig icon (+) to post a new gig.</p>
                </div>
            <% } %>
            <div style="height: 100px;"></div>
        </section>
    </main>

    <div id="gigDetailsModalCustomer" class="modal-overlay">
        <div class="modal-content gig-view-card">
            <h2 id="cust-display-title" class="purple-heading detail-main-title"></h2>
            
            <div class="detail-triple-row">
                <div class="detail-slot-row">
                    <label>Gig Category:</label>
                    <p id="cust-display-category" class="static-slot"></p>
                </div>
                <div class="detail-slot-row">
                    <label>Gig Budget:</label>
                    <p id="cust-display-budget" class="static-slot"></p>
                </div>
                <div class="detail-slot-row">
                    <label>Gig Date:</label>
                    <p id="cust-display-date" class="static-slot"></p>
                </div>
            </div>

            <div class="detail-slot-row">
                <label>Gig Description:</label>
                <p id="cust-display-description" class="static-slot description-slot"></p>
            </div>

            <div class="detail-slot-row">
                <label>Gig Address:</label>
                <p id="cust-display-address" class="static-slot"></p>
            </div>

            <div class="detail-slot-row">
                <label>Gig Images:</label>
                <div id="cust-display-images" class="image-display-area"></div>
            </div>

            <div class="modal-buttons">
                <button class="homegigs-button edit-btn">EDIT GIG</button>
                <button class="homegigs-button remove-btn">REMOVE GIG</button>
            </div>
            
            <div class="back-button-container">
                <a href="javascript:void(0)" class="back-arrow-link" onclick="$('#gigDetailsModalCustomer').fadeOut(300)">
                    <svg width="60" height="24" viewBox="0 0 60 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 12H59M1 12L12 1M1 12L12 23" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>

    <div id="removeConfirmModal" class="modal-overlay">
        <div class="modal-content remove-confirm-theme">
            <p class="purple-heading" style="font-size: 1.5rem;">Are you sure you want to remove this gig?</p>
            
            <div class="modal-buttons">
                <button id="confirmRemoveNo" class="homegigs-button btn-no-grey">NO</button>
                
                <button id="confirmRemoveYes" class="homegigs-button btn-yes-red">YES</button>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="JAVASCRIPT/script.js"></script>
    <script src="JAVASCRIPT/popups.js"></script>
</body>
</html>