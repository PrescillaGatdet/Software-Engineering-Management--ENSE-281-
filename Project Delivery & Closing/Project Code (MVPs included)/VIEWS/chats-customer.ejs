<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeGigs | Customer Chats</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Fugaz+One&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="CSS/style.css">
</head>
<body class="customer-mode">

    <nav id="sidebar">
        <div class="nav-links">
            <div class="top-nav">
                <a href="dashboard-customer.html">
                    <img src="IMAGES/HomeSymbol.png" class="nav-icon" alt="Home">
                </a>
                <a href="chats-customer.html" class="active">
                    <img src="IMAGES/InboxSymbol.png" class="nav-icon" alt="Chats">
                </a>
                <a href="post-gig.html">
                    <img src="IMAGES/AddPostSymbol.png" class="nav-icon" alt="Add Post">
                </a>
            </div>
            
            <div class="bottom-nav">
                <a href="account-customer.html">
                    <img src="IMAGES/ProfileSymbol.png" class="nav-icon" alt="Profile">
                </a>
            </div>
        </div>
    </nav>

    <main class="dashboard-content">
        <header class="dashboard-header">
            <div class="title-container">
                <img id="DashboardLogo" src="IMAGES/HomeGigsLogo.png" alt="HomeGigs Logo">
                <h1 class="purple-heading">Inbox</h1>
            </div>
            <p class="welcome-text">Connect with workers, bargain the prices, and manage your conversations here...</p>
        </header>

        <section class="content-body">
            <div class="chat-list-container" style="display: flex; flex-direction: column; gap: 15px;">
                <% if (gigs && gigs.length > 0) { %>
                    <% 
                       // Filter for gigs that are either in Bargain or Confirm state
                       const activeChats = gigs.filter(g => g.status === 'BARGAIN' || g.status === 'CONFIRM'); 
                    %>
                    
                    <% if (activeChats.length > 0) { %>
                        <% activeChats.forEach(gig => { %>
                            <div class="gig-detail-tile" 
                                 onclick="window.location.href='/view-chat/customer/<%= gig._id %>'"
                                 style="cursor: pointer; border-left: 10px solid" <%= gig.status === 'CONFIRM' ? '#ABFFAF' : '#FFEB3B' %>
                                <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                    <div>
                                        <h3 style="margin: 0; font-family: 'Fugaz One'; color: #8800B5;">
                                            <%= gig.title.toUpperCase() %>
                                        </h3>
                                        <p style="margin: 5px 0 0 0; font-family: 'Fredoka';">
                                            Status: <strong><%= gig.status %></strong>
                                        </div>
                                    <div style="text-align: right;">
                                        <p style="margin: 0; font-family: 'Fugaz One'; font-size: 1.2rem;">
                                            $<%= gig.negotiated_price || gig.budget %>
                                        </p>
                                        <small style="font-family: 'Fredoka'; color: #666;">View Conversation</small>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="placeholder-card">
                            <p>You have no active chats at the moment.</p>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="placeholder-card">
                        <p>You have no active chats at the moment.</p>
                    </div>
                <% } %>
            </div>
            
            <div style="height: 100px;"></div>
        </section>
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="JAVASCRIPT/script.js"></script>
</body>
</html>